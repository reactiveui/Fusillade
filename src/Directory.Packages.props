<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="11.0.100" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="MinVer" Version="8.0.0" />
    <PackageVersion Include="StyleSharp.Analyzers" Version="5.2.0" />
    <PackageVersion Include="PerformanceSharp.Analyzers" Version="5.2.0" />
    <PackageVersion Include="SecuritySharp.Analyzers" Version="5.2.0" />
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.1" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.36.0.15337" />
    <PackageVersion Include="ReactiveUI.Primitives" Version="10.0.0" />
    <PackageVersion Include="ReactiveUI.Primitives.Reactive" Version="10.0.0" />
  </ItemGroup>

  <!-- Benchmarks + tests -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="TUnit" Version="1.85.0" />
  </ItemGroup>
  
  <ItemGroup>
    <!-- Central package versions -->
    <PackageVersion Include="punchclock" Version="8.0.0" />
    <PackageVersion Include="Punchclock.Reactive" Version="8.0.0" />
    <PackageVersion Include="Splat" Version="22.0.1" />
    <PackageVersion Include="System.Net.Http" Version="4.3.4" />
    <PackageVersion Include="Akavache.SystemTextJson" Version="14.0.0" />
  </ItemGroup>
</Project>
